{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-new",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3d6302e9-faf3-4652-9978-f9d4dfdff2e4","database_name": "web-app-new" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4cbd200bdcc640c0ae5f00e9ed1009d6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
